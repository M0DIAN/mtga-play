    {"name": "viewing seat unknown", "patch": {"state": {"self_seat": null}},
     "expected": {"ready_for_decision": false, "fallback_reasons": ["viewing_seat_unknown"], "ready_for_action": false, "action_blockers": ["viewing_seat_unknown", "not_decision_player"], "waiting_on_current_request": false}},
    {"name": "timestamp has no timezone", "patch": {"checked_at": "2026-10-12T12:00:00"},
